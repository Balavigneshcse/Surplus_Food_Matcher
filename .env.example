# .env.example: copy to .env (git-ignored). Put comments on their own lines.
# DB_PASSWORD is used by compose.yaml; keep it in sync with APP_DATABASE_URL
# Do not put a % sign in the password (Alembic's config parser treats it specially).
DB_PASSWORD=change-me
# compose.yaml publishes Postgres on host port 5433
APP_DATABASE_URL=postgresql+psycopg://annamsetu:change-me@localhost:5433/annamsetu
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change-me
APP_ENV=dev
APP_DOCS=true
APP_DEMO=true
# Windows Mobile Hotspot address, so phones can open the QR
APP_PUBLIC_BASE_URL=http://192.168.137.1:8000
APP_SECURE_COOKIES=false
APP_SCHEDULER_ENABLED=true
# Demo-only passwords (8-64 characters); the seeder hashes them at startup
APP_DEMO_ADMIN_PASSWORD=change-me
APP_DEMO_KITCHEN_PASSWORD=change-me
APP_DEMO_NGO_PASSWORD=change-me
